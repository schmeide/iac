output "cluster_name" {
  description = "AKS cluster name. az aks get-credentials --resource-group <cluster_resource_group_name> --name <this>."
  value       = module.cluster.cluster_name
}

output "cluster_resource_group_name" {
  description = "Resource group the cluster, its Key Vault, and the gitops identity live in."
  value       = azurerm_resource_group.cluster.name
}

output "oidc_issuer_url" {
  description = "OIDC issuer URL of the cluster, for workload identity federated credentials."
  value       = module.cluster.oidc_issuer_url
}

output "key_vault_name" {
  description = "Platform Key Vault. Holds postgres-admin-password and forgejo-admin-password, both generated by terraform with write-only arguments."
  value       = module.cluster.key_vault_name
}

output "acr_login_server" {
  description = "Container registry login server. The cluster's kubelet can pull; schmeide.app's CI can push to schmeide-app."
  value       = module.registry.login_server
}

output "postgres_fqdn" {
  description = "Postgres server FQDN, private to the VNet. gitops/schmeide/temporal and forgejo values carry this same name."
  value       = module.postgres.fqdn
}

output "postgres_administrator_login" {
  description = "Postgres admin login. The password is in the Key Vault secret postgres-admin-password."
  value       = module.postgres.administrator_login
}

output "frontends_bundles_container_url" {
  description = "Private blob container generated frontend bundles are uploaded to, one <tenant>/<project>/<build>/ prefix each."
  value       = module.frontends.bundles_container_url
}

output "gitops_identity_client_id" {
  description = "Client id of the External Secrets workload identity. Not a secret."
  value       = azurerm_user_assigned_identity.gitops.client_id
}

output "ingress_ip_address" {
  description = "Static public IP of Traefik, pip-schmeide-ingress in schmeide-cluster. The A record api.schmeide.app at Porkbun points here."
  value       = module.cluster.ingress_ip_address
}

output "schmeide_app_push_client_id" {
  description = "Client id of schmeide.app's CI push identity, its AZURE_CLIENT_ID. Not a secret."
  value       = azurerm_user_assigned_identity.schmeide_app_push.client_id
}

output "tenant_id" {
  description = "Tenant of the subscription, schmeide.app's AZURE_TENANT_ID. Not a secret."
  value       = var.tenant_id
}

output "subscription_id" {
  description = "The subscription, schmeide.app's AZURE_SUBSCRIPTION_ID. Not a secret."
  value       = var.subscription_id
}

output "apps_name_servers" {
  description = "Name servers of the apps.schmeide.com zone. The owner adds one NS record for host apps at Porkbun per entry (README.md, \"DNS\")."
  value       = azurerm_dns_zone.apps.name_servers
}

output "cert_manager_identity_client_id" {
  description = "Client id of cert-manager's DNS-01 workload identity. Not a secret; passed to Argo by the argocd-bootstrap release."
  value       = azurerm_user_assigned_identity.cert_manager.client_id
}

output "worker_identity_client_id" {
  description = "Client id of the schmeide.app worker's workload identity. Not a secret; reaches the worker through Key Vault secret schmeide-app-worker-azure."
  value       = azurerm_user_assigned_identity.worker.client_id
}

output "acr_run_identity_client_id" {
  description = "Client id of the identity ACR runs push apps/* images as. Not a secret."
  value       = azurerm_user_assigned_identity.acr_run.client_id
}

output "acr_run_identity_id" {
  description = "ARM id of the identity ACR runs push apps/* images as."
  value       = azurerm_user_assigned_identity.acr_run.id
}
